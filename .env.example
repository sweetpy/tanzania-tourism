# Optional: canonical URL of this deployment (defaults to the Boker domain).
NEXT_PUBLIC_SITE_URL=https://www.bokeradventure.com

# Public Boker API origin. Server-only; never put secrets in this value.
# Existing itinerary data and saved requests stay in Pin Destinations.
BOKER_API_ORIGIN=https://pin-destinations-production.up.railway.app

# Preserve existing Wazi traveller/trade lead storage and delivery settings.
DATABASE_URL=
LEADS_LOG_PATH=
FOUNDER_EMAIL=support@pindestinations.com
LEADS_FROM_EMAIL=
RESEND_API_KEY=
LEADS_WEBHOOK_URL=

# Private departure desk access code, at least 32 random characters.
# Keep this server-only. Changing it revokes existing team sessions.
BOKER_GROUP_ADMIN_SECRET=
# Optional separate group database. Otherwise DATABASE_URL is used.
BOKER_GROUP_DATABASE_URL=
# Shared server-only signing key for anonymous group rate limits through the Boker edge.
BOKER_GROUP_PROXY_SECRET=
